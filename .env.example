# Local MCP (stdio mode)
MYSHOPIFY_DOMAIN=your-store.myshopify.com
SHOPIFY_ACCESS_TOKEN=shpat_xxx
REMOTE_MCP=false
# Optional: expose only the fail-closed read-only tool allowlist
# SHOPIFY_MCP_READ_ONLY=true

# Optional OAuth values (for `--oauth` flow)
# SHOPIFY_CLIENT_ID=your_client_id
# SHOPIFY_CLIENT_SECRET=your_client_secret
# SHOPIFY_SCOPES=comma,separated,scopes

# Remote mode only (ignored in local stdio mode)
# PORT=3000
# Without a key, the server binds only to 127.0.0.1 (local development).
# Configure a key for external clients or published container ports.
# MCP_API_KEY=change-me

# Optional exact browser origins allowed on MCP routes, comma-separated
# MCP_ALLOWED_ORIGINS=https://client.example

# Optional additional MCP Host header hostnames, comma-separated (no scheme/port)
# MCP_ALLOWED_HOSTS=mcp.example.com,internal-proxy.example.com
