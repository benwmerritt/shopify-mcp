# .env.example — copy to .env and fill in your values
#
# Run `npx robinhood-for-agents onboard` (select "Docker / remote") to get these.

# AES-256 encryption key for the Robinhood token file (base64)
ROBINHOOD_TOKEN_KEY=

# Path to the encrypted token file on the host
ROBINHOOD_TOKENS_PATH=~/.robinhood-for-agents/tokens.enc

# Ed25519 private key for signing gateway receipts (hex-encoded)
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BOLYRA_RECEIPT_KEY=
